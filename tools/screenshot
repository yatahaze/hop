#!/usr/bin/env bash
# Regenerate docs/demo.png, docs/demo-menu.png and docs/demo-narrow.png.
#
# Builds a throwaway home with fake repos, drives the real picker inside tmux
# at two widths, and renders what the terminal actually drew. The fixture is
# built here rather than pointed at your own bookmarks so the images stay
# reproducible and carry nobody's real directory names.
#
#   tools/screenshot
#
# Needs git, fzf, Pillow, and tmux. Without tmux it drives the picker through
# a pty instead (tools/ptyshot.py), which needs the pyte module.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")/.."
ROOT="$PWD"

for c in git fzf; do
  command -v "$c" >/dev/null || { echo "screenshot: needs $c" >&2; exit 1; }
done
if command -v tmux >/dev/null; then CAPTURE=tmux
elif python3 -c 'import pyte' 2>/dev/null; then CAPTURE=pty
else echo "screenshot: needs tmux, or pyte for python3" >&2; exit 1
fi

HOME_DIR="$(mktemp -d)"
trap 'rm -rf "$HOME_DIR"; tmux kill-session -t hop-shot 2>/dev/null || true' EXIT

# --- fixture ----------------------------------------------------------------
export GIT_AUTHOR_NAME=dev GIT_AUTHOR_EMAIL=dev@example.com
export GIT_COMMITTER_NAME=dev GIT_COMMITTER_EMAIL=dev@example.com
export GIT_AUTHOR_DATE="2026-08-28T10:14:00" GIT_COMMITTER_DATE="2026-08-28T10:14:00"

repo() {  # repo <dir> <file> <commit subject>
  mkdir -p "$(dirname "$HOME_DIR/$1/$2")"
  git -C "$HOME_DIR/$1" init -q -b main 2>/dev/null || true
  echo "placeholder" > "$HOME_DIR/$1/$2"
  git -C "$HOME_DIR/$1" add -A
  git -C "$HOME_DIR/$1" commit -qm "$3"
}
mkdir -p "$HOME_DIR"/src/{webapp,api,cli,webapp-docs,api-docs} \
         "$HOME_DIR"/.config/{nvim,tmux} "$HOME_DIR"/notes/journal "$HOME_DIR"/dotfiles
# The images show the column, which is off by default; the fixture asks for it.
mkdir -p "$HOME_DIR/.config/hop"; echo "column = auto" > "$HOME_DIR/.config/hop/config"
repo src/webapp src/settings.py "fix pagination on the results page"
repo src/api    main.go         "add rate limiting"
repo dotfiles   bashrc          "tidy prompt"
# a dirty file and an untracked one, so the status line in the pane is real
echo "changed"  > "$HOME_DIR/src/webapp/src/settings.py"
echo "untracked" > "$HOME_DIR/src/webapp/src/config.py"
mkdir -p "$HOME_DIR/src/webapp/.venv/bin"
echo "# fixture" > "$HOME_DIR/src/webapp/.venv/bin/activate"

cat > "$HOME_DIR/bookmarks" <<'EOF'
[repos]
*webapp         ~/src/webapp
api             ~/src/api
cli             ~/src/cli
webapp-docs     ~/src/webapp-docs
api-docs        ~/src/api-docs

[configs]
*nginx          /etc/nginx
nvim            ~/.config/nvim
tmux            ~/.config/tmux
dotfiles        ~/dotfiles

[notes]
todo            ~/notes
journal         ~/notes/journal
EOF

# --- capture ----------------------------------------------------------------
shoot() {  # shoot <cols> <rows> <out.png> [keys...]
  local cols="$1" rows="$2" out="$3"; shift 3
  if [ "$CAPTURE" = pty ]; then
    python3 "$ROOT/tools/ptyshot.py" "$cols" "$rows" "$@" -- \
      env HOME="$HOME_DIR" HOP_CONFIG="$HOME_DIR/bookmarks" HOP_WRAPPED=1 "$ROOT/hop" \
      | "$ROOT/tools/ansi2png.py" "$out"
    return
  fi
  tmux kill-session -t hop-shot 2>/dev/null || true
  tmux new-session -d -s hop-shot -x "$cols" -y "$rows" \
    "HOME='$HOME_DIR' HOP_CONFIG='$HOME_DIR/bookmarks' HOP_WRAPPED=1 '$ROOT/hop'"
  sleep 2.5                       # fzf needs to draw before we grab the pane
  local k
  for k in "$@"; do tmux send-keys -t hop-shot "$k"; sleep 1.3; done
  tmux capture-pane -pet hop-shot | "$ROOT/tools/ansi2png.py" "$out"
  tmux kill-session -t hop-shot 2>/dev/null || true
}

# Tab selects the first category: the point of the list images is the column
# filtering, not the unfiltered list. Enter on the first row opens the action
# menu; it takes over the screen, so that one is shot in a smaller terminal.
shoot 92 14 "$ROOT/docs/demo.png"        Tab
shoot 60 10 "$ROOT/docs/demo-menu.png"   Tab Enter
shoot 44 12 "$ROOT/docs/demo-narrow.png" Tab
