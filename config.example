# hop settings. Read from /etc/hop/config, then ~/.config/hop/config, with the
# later file winning. `key = value`, # starts a comment. Every key has a
# working default, so no file at all is fine.

# Where your ssh hosts come from. Default is the file ssh itself reads,
# ~/.ssh/config, with Include lines followed. Point it elsewhere, or turn it
# off on a machine that is only ever the destination and should not offer
# places to ssh out to. This file is per machine, which is the point.
#   ssh_config = ~/General/Settings/ssh/config
#   ssh_config = off

# Strip the chrome: no key hints, no match counter. Just the prompt and the
# list. Shorthand for `header = off`; `header` still wins where you set it.
#   minimal = on

# Category column down the left.
#   off   never show it; the header strip names the categories (default)
#   auto  fit it to the terminal, shedding detail as it narrows
#   on    always show it
#
# ^o toggles the column within a session whatever this says.
#   column = off

# The two header lines: the section and category strip, and the key hints.
#   header = on

# What enter offers, in order. The first is the default, so `enter enter`
# runs it. Leave one out and it is gone from the menu. pull and push only
# show for a git repository anyway.
#   actions = cd claude edit pull push pin
#   ssh_actions = ssh claude edit pin
