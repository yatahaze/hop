#!/usr/bin/env bash
# hop: a bookmark picker for the directories you actually work in, and the
# hosts you ssh to.
#
# Prints the chosen directory on stdout and nothing else; the shell wrapper
# installed by install.sh turns that into a `cd`. Everything the user sees
# (fzf, editors, claude, git) is written straight to /dev/tty so it never
# pollutes the captured stdout.

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hop"
SYS_DIR=/etc/hop

# Bookmarks merge from every source below, in order. The /etc files are system
# wide, the ones under ~ are yours; neither has to copy the other's list to add
# one line. A later source redefining the same category/name wins, so a personal
# file can override a system entry without masking the rest of it.
sources() {
  if [ -n "${HOP_CONFIG:-}" ]; then printf '%s\n' "$HOP_CONFIG"; return 0; fi
  local f
  [ -f "$SYS_DIR/bookmarks" ] && printf '%s\n' "$SYS_DIR/bookmarks"
  for f in "$SYS_DIR"/bookmarks.d/*.conf;  do [ -f "$f" ] && printf '%s\n' "$f"; done
  [ -f "$USER_DIR/bookmarks" ] && printf '%s\n' "$USER_DIR/bookmarks"
  for f in "$USER_DIR"/bookmarks.d/*.conf; do [ -f "$f" ] && printf '%s\n' "$f"; done
  return 0
}

die() { printf 'hop: %s\n' "$*" >&2; exit 1; }

# --- config -----------------------------------------------------------------
# Emits: category <TAB> name <TAB> path
# Only ~ and $HOME are expanded. The file is hand-edited but never eval'd.
parse_one() {
  local cat=misc line name path tok pin
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case $line in \#*) continue ;; esac
    line="${line%%[[:space:]]#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -z "$line" ] && continue

    if [[ $line == \[*\] ]]; then
      cat="${line:1:${#line}-2}"
      continue
    fi

    tok="${line%%[[:space:]]*}"
    path="${line#"$tok"}"
    path="${path#"${path%%[![:space:]]*}"}"
    # A leading * pins the entry to the top of the list.
    pin=0
    case $tok in \**) pin=1; tok="${tok#\*}" ;; esac
    if [ -z "$path" ]; then path="$tok"; name="$(basename "$path")"; else name="$tok"; fi

    path="${path//\$HOME/$HOME}"
    [ "${path:0:1}" = "~" ] && path="$HOME${path:1}"

    printf '%s\t%s\t%s\t%s\n' "$pin" "$cat" "$name" "$path"
  done < "$1"
}

# Settings: /etc/hop/config then ~/.config/hop/config, last one wins. Same
# system-then-user shape as bookmarks, so there is only one convention to
# learn. Format is `key = value`, # starts a comment.
setting() {
  local k="$1" v="$2" f got
  for f in "$SYS_DIR/config" "$USER_DIR/config"; do
    [ -r "$f" ] || continue
    got="$(sed -n "s/^[[:space:]]*$k[[:space:]]*=[[:space:]]*\([^#]*\).*/\1/p" "$f" | tail -1)"
    got="${got%"${got##*[![:space:]]}"}"
    [ -n "$got" ] && v="$got"
  done
  printf '%s' "$v"
}

# Pins toggled with ^t live here, as category/name plus a +/- state. Keyed
# rather than copied so a pin never carries a stale duplicate of a path you
# later edit, and so it can override a * that came from a file you do not own.
PINS="$USER_DIR/pins"

# --- ssh hosts --------------------------------------------------------------
# Hosts from your ssh config are a second source, emitted in the same
# pin/category/name/path shape so they merge, pin and filter like bookmarks.
# The path column carries ssh://user@host: what you see and filter on. The
# name is the alias, and `enter` runs `ssh <alias>` so every option in the
# config (key, port, jumps) applies exactly as it would from the shell.
#
# Setting `ssh_config` names the file; the default is where ssh itself looks.
# `off` disables the source, for machines that are only ever the destination.
# No `ssh` on PATH disables it too.
ssh_config_path() {
  local p; p="$(setting ssh_config "$HOME/.ssh/config")"
  case $p in off|no|none|"") printf 'off'; return 0 ;; esac
  ssh_path "$p"
}

ssh_source() {
  local p; p="$(ssh_config_path)"
  [ "$p" != off ] && [ -r "$p" ] && command -v ssh >/dev/null || return 0
  parse_ssh "$p" ssh 0
}

# A path as ssh_config writes it, to one this shell can open: ~ and $HOME
# expand, a relative path is under ~/.ssh as ssh resolves it, and a Windows
# drive path (a synced config is shared with Windows machines) is mapped for
# Git Bash, Cygwin or WSL.
ssh_path() {
  local p="$1" d
  p="${p//\$HOME/$HOME}"
  [ "${p:0:1}" = "~" ] && p="$HOME${p:1}"
  case $p in
    [A-Za-z]:[\\/]*)
      p="${p//\\//}"
      if command -v cygpath >/dev/null 2>&1; then p="$(cygpath -u "$p")"
      else d="${p:0:1}"; p="/mnt/${d,,}${p:2}"; fi ;;
    /*) ;;
    *)  p="$HOME/.ssh/$p" ;;
  esac
  printf '%s' "$p"
}

# Emits the pending host block. Reads the caller's locals, which is why it is
# a function and not a subshell.
ssh_emit() {
  [ -n "${alias:-}" ] || return 0
  printf '%s\t%s\t%s\tssh://%s%s\n' 0 "$hcat" "$alias" "${user:+$user@}" "${host:-$alias}"
}

# Categories come from marker comments, `# [acme/web]`, which ssh ignores and
# a generator can emit. Everything until the next marker belongs to it, under
# an `ssh/` prefix so typing `ssh` narrows to hosts. `Include` is followed; an
# included file with no markers is grouped by its file name, except one
# called `config`, which is a pointer and inherits.
#
# Wildcard and negated Host patterns and Match blocks are skipped: they are
# rules, not places you can go.
parse_ssh() {   # parse_ssh <file> <category> <depth>
  local f="$1" cat="$2" depth="$3" line key val tok inc g sub incs gs
  local alias="" hcat="" host="" user=""
  [ "$depth" -lt 8 ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    if [[ $line =~ ^[[:space:]]*#[[:space:]]*\[([^]]+)\][[:space:]]*$ ]]; then
      cat="ssh/${BASH_REMATCH[1]}"; continue
    fi
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    [[ $line =~ ^[[:space:]]*([A-Za-z]+)[[:space:]]*=?[[:space:]]*(.*)$ ]] || continue
    key="${BASH_REMATCH[1],,}"; val="${BASH_REMATCH[2]}"
    val="${val%"${val##*[![:space:]]}"}"
    val="${val#\"}"; val="${val%\"}"
    case $key in
      host)
        ssh_emit; alias=""
        tok="${val%%[[:space:]]*}"
        case $tok in ""|*[\*\?]*|\!*) ;; *) alias="$tok"; hcat="$cat"; host=""; user="" ;; esac ;;
      match)    ssh_emit; alias="" ;;
      hostname) host="$val" ;;
      user)     user="$val" ;;
      include)
        set -f; read -ra incs <<< "$val"; set +f
        for inc in "${incs[@]}"; do
          mapfile -t gs < <(compgen -G "$(ssh_path "$inc")")
          for g in "${gs[@]}"; do
            [ -f "$g" ] || continue
            sub="$(basename "$g")"; sub="ssh/${sub%.*}"
            [ "$sub" = ssh/config ] && sub="$cat"
            parse_ssh "$g" "$sub" $(( depth + 1 ))
          done
        done ;;
    esac
  done < "$f"
  ssh_emit
}

# sed program that prints the first pattern of each Host line, skipping
# wildcards, so it yields the aliases you could actually type.
HOSTRE='s/^[[:space:]]*[Hh]ost[[:space:]=]+([^[:space:]*?!]+).*/\1/p'

# The file to edit or replace. A config with no concrete hosts of its own and
# a single Include is a pointer, common when the real file lives in a synced
# folder, so follow it: editing the pointer is never what you meant.
ssh_edit_target() {
  local p="$1" hosts incs inc
  hosts="$(sed -nE "$HOSTRE" "$p" 2>/dev/null | grep -c .)"
  [ "${hosts:-0}" -eq 0 ] || { printf '%s' "$p"; return 0; }
  mapfile -t incs < <(sed -nE 's/^[[:space:]]*[Ii]nclude[[:space:]=]+//p' "$p" | tr -d '"\r')
  [ "${#incs[@]}" -eq 1 ] || { printf '%s' "$p"; return 0; }
  inc="$(ssh_path "${incs[0]}")"
  [ -f "$inc" ] && printf '%s' "$inc" || printf '%s' "$p"
}

# Whatever holds the clipboard here: a Mac, Wayland, X, WSL or Git Bash, a
# phone in Termux. Fails if none does, and the caller says to pipe instead.
clipboard() {
  if command -v pbpaste >/dev/null; then pbpaste
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null; then wl-paste --no-newline
  elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null; then xclip -selection clipboard -o
  elif [ -n "${DISPLAY:-}" ] && command -v xsel >/dev/null; then xsel -b -o
  elif command -v termux-clipboard-get >/dev/null; then termux-clipboard-get
  elif command -v powershell.exe >/dev/null; then powershell.exe -NoProfile -Command Get-Clipboard | tr -d '\r'
  else return 1; fi
}

# Replace the ssh config with the clipboard, a file, or stdin. For when a
# server inventory generates the whole file and you want it in place without
# hunting for the path. Checked with `ssh -G` before anything is touched, and
# the old file is kept beside it as .bak. Everything goes to stderr: stdout
# is the wrapper's, and a message there would become a cd.
ssh_import() {
  local cfg="$1" src="${2:-}" new tmp first old_hosts new_hosts n hostre="$HOSTRE"
  if [ -n "$src" ]; then new="$(cat "$src")" || die "cannot read $src"
  elif [ ! -t 0 ]; then new="$(cat)"
  else new="$(clipboard)" || die "no clipboard tool found. Pipe it instead: hop --ssh-import < file"
  fi
  new="$(printf '%s\n' "$new" | tr -d '\r')"
  first="$(printf '%s\n' "$new" | sed -nE "$hostre" | head -1)"
  [ -n "$first" ] || die "that does not look like an ssh config: no Host line"
  tmp="$(mktemp)"; printf '%s\n' "$new" > "$tmp"
  if ! ssh -G -F "$tmp" "$first" >/dev/null 2>"$tmp.err"; then
    printf 'hop: ssh rejects it, nothing written:\n' >&2; sed 's/^/     /' "$tmp.err" >&2
    rm -f "$tmp" "$tmp.err"; exit 1
  fi
  rm -f "$tmp.err"
  old_hosts="$( [ -f "$cfg" ] && sed -nE "$hostre" "$cfg" | sort -u)"
  new_hosts="$(printf '%s\n' "$new" | sed -nE "$hostre" | sort -u)"
  mkdir -p "$(dirname "$cfg")"
  [ -f "$cfg" ] && cp -p "$cfg" "$cfg.bak"
  chmod 600 "$tmp" 2>/dev/null; mv "$tmp" "$cfg"
  n="$(printf '%s\n' "$new_hosts" | grep -c .)"
  printf 'hop: wrote %s hosts to %s' "$n" "$cfg" >&2
  [ -f "$cfg.bak" ] && printf ' (old copy in %s)' "$(basename "$cfg.bak")" >&2
  printf '\n' >&2
  comm -13 <(printf '%s\n' "$old_hosts") <(printf '%s\n' "$new_hosts") | grep . | sed 's/^/     + /' >&2
  comm -23 <(printf '%s\n' "$old_hosts") <(printf '%s\n' "$new_hosts") | grep . | sed 's/^/     - /' >&2
  return 0
}

parse_merged() {
  local f
  { while IFS= read -r f; do parse_one "$f"; done < <(sources); ssh_source; } |
    awk -F'\t' '{ k=$2 FS $3
                  if (!(k in seen)) { seen[k]=1; order[++n]=k }
                  val[k]=$0 }
                END { for (i=1;i<=n;i++) print val[order[i]] }' |
    awk -F'\t' -v pf="$PINS" '
      BEGIN { while ((getline l < pf) > 0)
                if (l ~ /^[+-]/) ov[substr(l,2)] = (substr(l,1,1) == "+") }
      { k=$2 FS $3
        if (k in ov) $1 = (ov[k] ? 1 : 0)
        line = $1 FS $2 FS $3 FS $4
        if (!(k in seen)) { seen[k]=1; order[++n]=k }
        val[k]=line }
      END { for (i=1;i<=n;i++) print val[order[i]] }'
}

# Pinned first, file order within each group.
parse() {
  parse_merged | awk -F'\t' '{ line[NR]=$0 } END {
    for (i=1;i<=NR;i++) if (line[i] ~ /^1\t/) print line[i]
    for (i=1;i<=NR;i++) if (line[i] !~ /^1\t/) print line[i] }'
}

# A bookmark may point at a file (~/.bashrc); you hop to its directory.
destdir() { if [ -d "$1" ]; then printf '%s' "$1"; else dirname "$1"; fi; }

# Find a virtualenv to activate for a directory. Walks up because the venv
# usually sits beside the project rather than inside the package dir it points
# at. Stops at $HOME so it never escapes into shared parents.
venv_for() {
  local d="$1" c
  while [ -n "$d" ] && [ "$d" != "/" ]; do
    for c in venv .venv env; do
      if [ -r "$d/$c/bin/activate" ]; then printf '%s' "$d/$c/bin/activate"; return 0; fi
    done
    [ "$d" = "$HOME" ] && break
    d="$(dirname "$d")"
  done
  return 1
}

# --- actions ----------------------------------------------------------------
# enter opens a small menu of what to do with the entry, in the middle of the
# screen, rather than a chord per action that nobody remembers. The first row
# is the default, so `enter enter` takes you there and `enter down enter`
# starts claude. `actions` and `ssh_actions` in the settings order the rows,
# and drop any you never use. pull and push only appear for a git repo.
is_repo() { git -C "$1" rev-parse --git-dir >/dev/null 2>&1; }

action_row() {   # action_row <name> <color> <description>
  printf '\033[%sm%-7s\033[0m \033[2m%s\033[0m\t%s\n' "$2" "$1" "$3" "$1"
}

action_rows() {  # action_rows <dir|ssh> <dir>
  local kind="$1" dir="$2" a list ed
  ed="${EDITOR:-vi}"; ed="${ed%% *}"; ed="$(basename "$ed")"
  if [ "$kind" = ssh ]; then list="$(setting ssh_actions "ssh claude edit")"
  else list="$(setting actions "cd claude edit pull push")"; fi
  for a in ${list//,/ }; do
    case "$kind/$a" in
      dir/cd)     action_row cd     32 "go there" ;;
      dir/claude) action_row claude 35 "start claude there" ;;
      dir/edit)   action_row edit   34 "open in $ed" ;;
      dir/pull)   is_repo "$dir" && action_row pull 33 "git pull" ;;
      dir/push)   is_repo "$dir" && action_row push 33 "git push" ;;
      ssh/ssh)    action_row ssh    32 "connect" ;;
      ssh/claude) action_row claude 35 "connect, then claude" ;;
      ssh/edit)   action_row edit   34 "open the ssh config" ;;
    esac
  done
  return 0
}

# A boxed list centred on the screen, sized to its rows: fzf's margins do the
# centring, and its full-screen mode gives the terminal back untouched when
# the box closes. Prints the chosen action, or nothing for escape.
menu() {         # menu <dir|ssh> <name> <dir>
  local rows n lines cols w h t l b
  rows="$(action_rows "$1" "$3")"
  [ -n "$rows" ] || return 0
  n="$(printf '%s\n' "$rows" | grep -c .)"
  read -r lines cols < <(stty size </dev/tty 2>/dev/null) || true
  [ "${lines:-0}" -gt 0 ] || lines="$(tput lines 2>/dev/null || echo 24)"
  [ "${cols:-0}" -gt 0 ]  || cols="$(tput cols 2>/dev/null || echo 80)"
  w=40; [ "$w" -gt "$cols" ] && w="$cols"
  # Rows, the prompt line, and the two border lines. hidden info still draws
  # its separator rule, which would eat the last row, hence no-separator.
  h=$(( n + 3 ))
  l=$(( (cols - w) / 2 )); t=$(( (lines - h) / 2 )); b=$(( lines - h - t ))
  [ "$t" -lt 0 ] && t=0; [ "$b" -lt 0 ] && b=0
  printf '%s\n' "$rows" | fzf \
    --ansi --layout=reverse --info=hidden --no-separator --prompt='> ' \
    --delimiter=$'\t' --with-nth=1 --nth=1 \
    --border=rounded --border-label=" $2 " --border-label-pos=2 \
    --margin="$t,$l,$b,$l" \
    --color=border:cyan,label:cyan:bold,pointer:cyan,prompt:cyan \
    | cut -f2
  return 0
}

# Column widths come from the whole set, not the filtered subset, so cycling
# between categories does not make the list jitter. HOP_ALL and HOP_SHOWPATH
# are exported so the reload subprocess renders rows identically to the parent.
#
# The filter is "" for everything, @bookmarks or @ssh for a section, or a
# category name. Within the ssh section the ssh/ prefix is dropped from the
# category column, since every row would carry it.
rows_for() {
  [ "${HOP_STRIP:-0}" = 1 ] && strip_for "${1:-}"
  parse | awk -F'\t' -v all="${HOP_ALL:-0}" -v home="$HOME" \
                     -v only="${1:-}" -v showpath="${HOP_SHOWPATH:-1}" '
    { pn[NR]=$1; cat[NR]=$2; nm[NR]=$3; pa[NR]=$4
      ssh[NR]=($4 ~ /^ssh:\/\//)
      c=$2; if (only=="@ssh") sub(/^ssh\/?/, "", c)
      if (length(c)+1>cw) cw=length(c)+1
      if (length($3)>nw) nw=length($3)
      n=NR }
    END {
      for (i=1;i<=n;i++) {
        if (all=="0" && !ssh[i] && system("test -e \"" pa[i] "\"")!=0) continue
        if (only=="@ssh" && !ssh[i]) continue
        if (only=="@bookmarks" && ssh[i]) continue
        if (only != "" && only !~ /^@/ && cat[i] != only) continue
        mark = (pn[i]=="1" ? "*" : " ")
        c=cat[i]; if (only=="@ssh") sub(/^ssh\/?/, "", c)
        pre  = (only=="" || only ~ /^@/ ? sprintf("\033[2m%-*s\033[0m ", cw, (c=="" ? "" : c"/")) : "")
        if (showpath=="1") {
          short=pa[i]; sub("^" home, "~", short); sub(/^ssh:\/\//, "", short)
          printf "%s%s%-*s \033[2m%s\033[0m\t%s\t%s\t%s\n", mark, pre, nw, nm[i], short, pa[i], cat[i], nm[i]
        } else
          printf "%s%s%s\t%s\t%s\t%s\n", mark, pre, nm[i], pa[i], cat[i], nm[i]
      }
    }'
}

categories() { parse_merged | cut -f2 | awk '!seen[$0]++'; }

# The tab strip: the sections as tabs with the active one lit, then the
# categories alt-N reaches, lit instead when the filter is one of those. It
# is the first row of every list fzf is given, shown with --header-lines, so
# it follows every tab press in any fzf version; a header a bind can rewrite
# needs a newer fzf than some machines have.
strip_tab() {    # strip_tab <filter> <label>, lit when the filter is current
  if [ "$1" = "$cur" ]; then printf '\033[1;7;36m %s \033[0m' "$2"
  else                       printf '\033[2m %s \033[0m' "$2"; fi
}
strip_for() {    # strip_for <current filter>
  local cur="$1" s a="" c i=0 len alen=0
  s="$(strip_tab "" all)"; len=5
  if [ "$(sections | head -1)" = "@bookmarks" ]; then
    s="$s$(strip_tab @bookmarks bookmarks)$(strip_tab @ssh ssh)"; len=$(( len + 16 ))
    while IFS= read -r c; do
      [ -z "$c" ] && continue; i=$(( i + 1 )); [ "$i" -gt 9 ] && break
      a="$a$(strip_tab "$c" "$i:$c")"; alen=$(( alen + ${#c} + 4 ))
    done < <(categories)
    # The category list is the first thing to go when the strip will not fit;
    # the active category, if there is one, stays so you can see it.
    if [ $(( len + 5 + alen )) -le "${HOP_STRIPW:-80}" ]; then s="$s "$'\033[2m'"alt"$'\033[0m'"$a"
    elif [ -n "$cur" ] && [ "${cur#@}" = "$cur" ]; then s="$s$(strip_tab "$cur" "$cur")"; fi
  else
    while IFS= read -r c; do
      [ -z "$c" ] && continue; i=$(( i + 1 )); [ "$i" -gt 9 ] && break
      s="$s$(strip_tab "$c" "$i:$c")"
    done < <(categories)
  fi
  printf '%s\n' "$s"
}

# What tab walks. Bookmarks and ssh hosts are different enough that you want
# one or the other, so with both present tab goes all, bookmarks, ssh. With
# only one kind there is nothing to switch between, and tab walks the
# categories instead, as it always did. alt-N always jumps to a category.
sections() {
  local s; s="$(parse_merged | awk -F'\t' '{ if ($4 ~ /^ssh:\/\//) s=1; else b=1 }
                                          END { print (b?1:0) (s?1:0) }')"
  case $s in 11) printf '@bookmarks\n@ssh\n' ;; *) categories ;; esac
}

# --- section cycling (invoked by fzf as a subprocess) -----------------------
# Typing is the expensive part on a phone, so tab walks the sections. State is
# the current filter, kept in a file because fzf 0.37 has no `transform`
# action to carry it. `+1`/`-1` step through the cycle from wherever the
# filter is now; `=N` is alt-N, straight to the Nth category.
if [ "${1:-}" = "--cycle" ]; then
  spec="${2:-+1}"; state="${3:-}"
  cur=""; [ -s "$state" ] && cur="$(cat "$state")"
  case "$spec" in
    =*) mapfile -t cats < <(categories); i="${spec#=}"
        [ "$i" -ge 1 ] && [ "$i" -le "${#cats[@]}" ] && cur="${cats[i-1]}" ;;
    *)  mapfile -t cyc < <(sections)
        idx=0; for i in "${!cyc[@]}"; do [ "${cyc[i]}" = "$cur" ] && idx=$(( i + 1 )); done
        n=${#cyc[@]}
        idx=$(( (idx + (spec)) % (n + 1) )); [ "$idx" -lt 0 ] && idx=$(( idx + n + 1 ))
        cur=""; [ "$idx" -gt 0 ] && cur="${cyc[idx-1]}" ;;
  esac
  printf '%s' "$cur" > "$state"
  rows_for "$cur"
  exit 0
fi

# --- pin toggle (invoked by fzf as a subprocess) ----------------------------
if [ "${1:-}" = "--pin" ]; then
  pcat="${2:-}"; pname="${3:-}"
  [ -n "$pcat" ] && [ -n "$pname" ] || exit 0
  cur="$(parse | awk -F'\t' -v c="$pcat" -v n="$pname" '$2==c && $3==n {print $1; exit}')"
  [ "$cur" = "1" ] && sign="-" || sign="+"
  mkdir -p "$(dirname "$PINS")"
  tmp="$(mktemp)"
  [ -f "$PINS" ] && grep -vxF -- "+$pcat	$pname" "$PINS" | grep -vxF -- "-$pcat	$pname" > "$tmp"
  printf '%s%s\t%s\n' "$sign" "$pcat" "$pname" >> "$tmp"
  mv "$tmp" "$PINS"
  exit 0
fi

# --- category pane (invoked by fzf as a subprocess) -------------------------
# fzf gives one list and one side pane. The pane is not interactive, but the
# interaction here is hotkeys, not arrowing into it -- so it renders the
# category column, with the active one marked, plus a compact status for the
# selected row underneath.
if [ "${1:-}" = "--pane" ]; then
  sel="${2:-}"; state="${3:-}"; alias="${4:-}"; w="${HOP_PANEW:-20}"
  mapfile -t cats < <(categories)
  cur=""; [ -s "$state" ] && cur="$(cat "$state")"
  idx=0; for i in "${!cats[@]}"; do [ "${cats[i]}" = "$cur" ] && idx=$(( i + 1 )); done
  # Counts and the status block are the first things to go when the column is
  # narrow; the category names are the reason the column exists.
  [ "$w" -ge 12 ] && counts=1 || counts=0
  nw=$(( w - 2 )); [ "$counts" = 1 ] && nw=$(( w - 5 ))
  [ "$w" -ge 12 ] && printf '\033[1mCATEGORIES\033[0m\n' || printf '\033[1mCATS\033[0m\n'
  i=0
  for c in "${cats[@]}"; do
    i=$(( i + 1 ))
    if [ "$counts" = 1 ]; then
      n=$(parse | awk -F'\t' -v c="$c" '$2==c{n++} END{print n+0}')
      if [ "$i" -eq "$idx" ]; then printf '\033[7m%d %-*s %2d\033[0m\n' "$i" "$nw" "$c" "$n"
      else                         printf '%d %-*s \033[2m%2d\033[0m\n'  "$i" "$nw" "$c" "$n"; fi
    else
      if [ "$i" -eq "$idx" ]; then printf '\033[7m%d %-*s\033[0m\n' "$i" "$nw" "$c"
      else                         printf '%d %-*s\n'                "$i" "$nw" "$c"; fi
    fi
  done
  # The bottom line names the section: all, or the one tab landed on.
  case $cur in
    "") printf '\033[7m%-*s\033[0m\n' "$w" "  all" ;;
    @*) printf '\033[7m%-*s\033[0m\n' "$w" "  ${cur#@}" ;;
    *)  printf '\033[2m  all\033[0m\n' ;;
  esac
  # Vertical space is scarce on a phone, so the status block is desktop-only.
  [ "${HOP_PANESTATUS:-1}" = 1 ] || exit 0
  case $sel in
    ssh://*)
      # Who you would land as, where, and with which key, without connecting.
      printf '\n\033[2m%*s\033[0m\n' "$w" "" | tr ' ' '-'
      ssh -G -F "$(ssh_config_path)" "$alias" 2>/dev/null | awk -v w="$w" '
        $1=="user" {u=$2} $1=="hostname" {h=$2} $1=="port" {p=$2}
        $1=="identityfile" {kc++; if (kc==1) {k=$2; sub(".*/", "", k)}}
        $1=="proxyjump" && $2!="none" {j=$2}
        END { if (h=="") exit
              printf "\033[33m%s\033[0m\n", substr(u "@" h, 1, w)
              if (p!="" && p!="22") printf "port %s\n", p
              # one identityfile means the config named it; several is the default list
              if (kc==1) printf "\033[2m%s\033[0m\n", substr(k, 1, w)
              if (j!="") printf "via %s\n", substr(j, 1, w-4) }'
      exit 0 ;;
  esac
  [ -n "$sel" ] && [ -e "$sel" ] || exit 0
  printf '\n\033[2m%*s\033[0m\n' "$w" "" | tr ' ' '-'
  d="$(destdir "$sel")"
  if git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then
    b="$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    [ "${#b}" -gt $(( w - 7 )) ] && b="${b:0:$(( w - 8 ))}…"
    n="$(git -C "$d" status --porcelain 2>/dev/null | wc -l)"
    if [ "$n" -gt 0 ]; then printf '\033[33m%s\033[0m \033[31m*%s\033[0m\n' "$b" "$n"
    else                    printf '\033[33m%s\033[0m \033[32mclean\033[0m\n' "$b"; fi
  fi
  venv_for "$d" >/dev/null 2>&1 && printf '\033[32mvenv\033[0m\n'
  exit 0
fi

# --- preview (invoked by fzf as a subprocess) -------------------------------
if [ "${1:-}" = "--preview" ]; then
  p="${2:-}"
  [ -e "$p" ] || { echo "missing: $p"; exit 0; }
  case "$p" in "$HOME"/*) echo "~${p#"$HOME"}" ;; *) echo "$p" ;; esac
  echo
  d="$(destdir "$p")"
  if git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$d" -c color.ui=always status -sb 2>/dev/null | head -20
    echo
    git -C "$d" -c color.ui=always log --oneline -5 2>/dev/null
    echo
  fi
  if v="$(venv_for "$d")"; then
    case "$v" in "$HOME"/*) v="~${v#"$HOME"}" ;; esac
    printf 'venv: %s\n\n' "$v"
  fi
  ls -A --color=always "$d" 2>/dev/null | head -30
  exit 0
fi

show_all=0
case "${1:-}" in
  --all) show_all=1; shift ;;
  -h|--help)
    cat >&2 <<'USAGE'
hop [--all] [query]     pick a bookmark or an ssh host; the shell wrapper
                        cds you there, or connects
hop --edit              open your bookmarks file in $EDITOR
hop --list              print entries as category<TAB>name<TAB>path
hop --ssh-edit          open your ssh config in $EDITOR
hop --ssh-import [file] replace your ssh config from the clipboard, a file,
                        or stdin; checked with `ssh -G` first, old copy in .bak

In the picker:
  tab / shift-tab   all, bookmarks, ssh hosts (or the categories, with one kind)
  alt-1..9          jump straight to a category
  type              filter, category names match too
  enter             open the actions for it: go there, claude, edit, pull,
                    push. The first is the default, so enter twice goes there
  ^t                pin or unpin the selected entry (kept in ~/.config/hop/pins)
  ^o                show or hide the category column

Hosts come from ~/.ssh/config, Include lines followed. `# [name]` comments
group them. Set `ssh_config = <file>` or `ssh_config = off` in
~/.config/hop/config.
USAGE
    exit 0 ;;
  --ssh-edit)
    cfg="$(ssh_config_path)"; [ "$cfg" != off ] || die "ssh_config is off in your settings"
    exec ${EDITOR:-vi} "$(ssh_edit_target "$cfg")" ;;
  --ssh-import)
    cfg="$(ssh_config_path)"; [ "$cfg" != off ] || die "ssh_config is off in your settings"
    ssh_import "$(ssh_edit_target "$cfg")" "${2:-}"; exit 0 ;;
  --edit)
    mkdir -p "$USER_DIR"
    if [ ! -f "$USER_DIR/bookmarks" ]; then
      cat > "$USER_DIR/bookmarks" <<'SEED'
# Your bookmarks. These MERGE with anything in /etc/hop, so you only need what
# is yours. Repeating a category/name from there overrides just that one.
# Drop-ins in ~/.config/hop/bookmarks.d/*.conf are merged too.

[mine]
SEED
    fi
    exec ${EDITOR:-vi} "$USER_DIR/bookmarks" ;;
  --list) parse | cut -f2-; exit 0 ;;
esac

[ -n "$(sources)" ] || [ -n "$(ssh_source)" ] || die "no bookmarks in $SYS_DIR or $USER_DIR. Run: hop --edit"
command -v fzf >/dev/null || die "fzf is not on PATH"
# Without the shell function this prints a path and leaves you put, which reads
# as "hop is broken" rather than "hop is not installed properly".
[ -n "${HOP_WRAPPED:-}" ] || printf 'hop: shell function not loaded, so this will print a path instead of taking you there.\n     Run: source ~/.bashrc   (or open a new shell)\n' >&2

# --- layout -----------------------------------------------------------------
# The preview costs half the width, which a phone terminal does not have, so
# below 90 columns it starts hidden. ^o toggles it either way.
cols="${HOP_COLS:-$(tput cols 2>/dev/null || echo 80)}"
export HOP_PANEW=20 HOP_PANESTATUS=1
# `minimal = on` is shorthand for turning the chrome off; the individual keys
# still win where they are set, so it is a default rather than a mode lock.
minimal="$(setting minimal off)"
[ "$minimal" = on ] && hdef=off || hdef=on
# column = off (default: the header strip names the sections and categories
# instead) | auto (fit it to the terminal) | on (always). ^o still toggles it
# within a session either way.
want_col=1
case "$(setting column off)" in
  off) want_col=0 ;;
  on)  [ "$cols" -lt 40 ] && cols=40 ;;
esac
show_header="$(setting header "$hdef")"
if   [ "$want_col" = 0 ]; then pvw="hidden,left,13,border-right"; listw="$cols";          hgt=80%
elif [ "$cols" -ge 76 ]; then pvw="left,22,border-right";        listw=$(( cols - 22 )); hgt=80%
elif [ "$cols" -ge 56 ]; then export HOP_PANEW=14
                              pvw="left,16,border-right";        listw=$(( cols - 16 )); hgt=100%
elif [ "$cols" -ge 40 ]; then export HOP_PANEW=12 HOP_PANESTATUS=0
                              pvw="left,13,border-right";        listw=$(( cols - 23 )); hgt=100%
else                          pvw="hidden,left,13,border-right"; listw="$cols";          hgt=100%; fi
# The path column is the first thing to go when it will not fit.
if [ "$listw" -ge 56 ]; then export HOP_SHOWPATH=1; else export HOP_SHOWPATH=0; fi
export HOP_ALL="$show_all"
# The tab strip rides on the list when the column is not there to show it.
case $pvw in hidden*) export HOP_STRIP=1 HOP_STRIPW="$listw" ;; *) export HOP_STRIP=0 ;; esac

missing="$(parse | awk -F'\t' -v all="$show_all" '{ if (all=="0" && $4 !~ /^ssh:\/\// && system("test -e \"" $4 "\"")!=0) m++ } END { print m+0 }')"
rows="$(rows_for "")"
[ -n "$rows" ] || die "no bookmark path exists on this machine (try: hop --all)"

state="$(mktemp)"; trap 'rm -f "$state"' EXIT INT TERM HUP
: > "$state"

binds=( --bind "ctrl-o:toggle-preview"
        --bind "ctrl-t:execute-silent($SELF --pin {3} {4})+reload($SELF --cycle +0 $state)"
        --bind "tab:reload($SELF --cycle +1 $state)"
        --bind "btab:reload($SELF --cycle -1 $state)" )
i=0
while IFS= read -r c; do
  [ -z "$c" ] && continue
  i=$(( i + 1 )); [ "$i" -gt 9 ] && break
  binds+=( --bind "alt-$i:reload($SELF --cycle =$i $state)" )
done < <(categories)

# The hints fit at any width now that enter is the only way in.
hdr="enter · ^t pin"
[ "$missing" -gt 0 ] && hdr="$hdr"$'\n'"$missing not here (--all)"

info=inline; hdrarg=(--header "$hdr")
if [ "$show_header" = off ]; then hdrarg=(); info=hidden; fi

# enter opens the action menu for the row. Escape there comes back here with
# the query and the section intact, so a wrong row costs one keypress.
query="${1:-}"
while :; do
  out="$(printf '%s\n' "$rows" | fzf \
    --ansi --layout=reverse --border --height="$hgt" --info="$info" \
    --delimiter=$'\t' --with-nth=1 --nth=1 --header-lines="$HOP_STRIP" \
    --prompt='hop > ' "${hdrarg[@]}" \
    --print-query --query="$query" \
    "${binds[@]}" \
    --preview="'$SELF' --pane {2} $state {4}" --preview-window="$pvw")"

  query="$(printf '%s' "$out" | sed -n 1p)"
  sel="$(printf '%s' "$out" | sed -n 2p)"
  [ -n "$sel" ] || exit 0

  # Field 2 is the path; the row also carries category and name after it.
  target="$(printf '%s' "$sel" | cut -f2)"
  name="$(printf '%s' "$sel" | cut -f4)"
  case $target in
    ssh://*) kind=ssh; dir="" ;;
    *)       kind=dir; dir="$(destdir "$target")" ;;
  esac

  act="$(menu "$kind" "$name" "$dir")"
  [ -n "$act" ] && break
  rows="$(rows_for "$(cat "$state")")"
done

# An ssh host: connect on the tty and print nothing, so the wrapper stays put.
# The alias is the name column; the config supplies everything else. `edit`
# opens the config, since that is where the entry lives. claude runs through
# a login shell on the far side so it is found wherever the profile puts it.
case "$kind/$act" in
  ssh/ssh)    ssh "$name"                                               </dev/tty >/dev/tty 2>&1; exit 0 ;;
  ssh/claude) ssh -t "$name" '$SHELL -lic claude'                       </dev/tty >/dev/tty 2>&1; exit 0 ;;
  ssh/edit)   ${EDITOR:-vi} "$(ssh_edit_target "$(ssh_config_path)")"  </dev/tty >/dev/tty 2>&1; exit 0 ;;
  # Directory actions take the tty; stdout stays clean so the wrapper can
  # still cd once they return.
  dir/claude) ( cd "$dir" && claude )                     </dev/tty >/dev/tty 2>&1 ;;
  dir/edit)   ( cd "$dir" && ${EDITOR:-vi} "$target" )    </dev/tty >/dev/tty 2>&1 ;;
  dir/pull)   ( cd "$dir" && git pull )                   </dev/tty >/dev/tty 2>&1 ;;
  dir/push)   ( cd "$dir" && git push )                   </dev/tty >/dev/tty 2>&1 ;;
esac

# Line 1 is where to go; optional line 2 is a virtualenv for the wrapper to
# activate. Both have to happen in the parent shell, so neither can be done here.
printf '%s\n' "$dir"
# Not a pipeline: with pipefail a failed lookup would become hop's exit status,
# and the wrapper would abort before the cd for every bookmark without a venv.
v="$(venv_for "$dir" 2>/dev/null || true)"
[ -n "$v" ] && printf '%s\n' "$v"
exit 0
