# hop bookmarks — one per line, grouped under [category] headers.
#
#   name    path          explicit name
#   path                  name defaults to the basename
#
# ~ and $HOME are expanded. Nothing else is — this file is read, never eval'd.
# Bookmarks whose path doesn't exist on the current machine are hidden
# (the count shows in the header; `hop --all` reveals them).
#
# Categories are yours to invent — they're just the filter prefix.

[repos]
hop             ~/hop
dotfiles        ~/dotfiles

[apps]
# wherever you keep checkouts you work in
myapp           ~/apps/myapp

[configs]
claude          ~/.claude
nvim            ~/.config/nvim
fish            ~/.config/fish
~/.bashrc
bin             ~/bin
